{
    "configurations": [
        {
            "name": "My Build and Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/_a.exe",
            "args": ["arg1", "arg2"],
            "stopAtEntry": true,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:\\c\\mingw64\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "My build g++"
        }
    ],
    "version": "2.0.0"
}